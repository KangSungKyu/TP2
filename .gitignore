# This .gitignore file is configured for Unity project (Unity 6 / standard Unity setup).

# Unity temporary & generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Pp]rofiler[Cc]aptures/
/[Rr]ecordings/

# Autogenerated C# solution and project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db
*.csproj.Backup.tmp

# Visual Studio / Visual Studio Code / JetBrains Rider / IDE files
.vs/
.idea/
.vscode/
*.csproj.user

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Build artifacts & package outputs
*.apk
*.aab
*.unitypackage
*.app
sysinfo.txt

# Python temporary files (for pixel art / animation generation scripts)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Crash reports & local dumps
sysinfo.txt
test_out*.log

# TP2 coordination MCP local runtime only
/scripts/coordination_mcp/*.sqlite*
/scripts/coordination_mcp/.env
